# Frontend environment variables — copy to `.env.local` and fill in locally.
# NEVER commit the real `.env.local` file. See ../.gitignore.
#
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# Backend secrets (ANTHROPIC_API_KEY, DATABASE_URL, etc.) must NEVER be
# defined here or anywhere with a NEXT_PUBLIC_ prefix — the frontend never
# calls Anthropic or the database directly, only this app's own backend API.

# Base URL of the FastAPI backend this frontend talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Deployment environment label, used only for non-sensitive UI/debug display.
NEXT_PUBLIC_APP_ENV=development

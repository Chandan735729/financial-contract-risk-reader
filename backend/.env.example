# Backend environment variables — copy to `.env` and fill in real values locally.
# NEVER commit the real `.env` file. See ../.gitignore.
#
# In ENVIRONMENT=production, the app fails fast at startup if any required
# production variable below is missing or left as a placeholder — see
# backend/app/core/config.py.

# One of: development | test | production
ENVIRONMENT=development

# SQLAlchemy connection string. Must be a real PostgreSQL URL in production
# (postgresql+psycopg://user:password@host:port/dbname).
# A local sqlite file is acceptable for development only.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/financial_contract_risk_reader

# Anthropic API key used by the Generation Service (Grounding_and_Evidence_Spec.md).
# Backend-only. Never expose to the frontend, never log this value.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

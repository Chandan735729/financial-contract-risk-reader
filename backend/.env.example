# Backend environment variables — copy to `.env` and fill in real values locally.
# NEVER commit the real `.env` file. See ../.gitignore.
#
# In ENVIRONMENT=production, the app fails fast at startup if any required
# production variable below is missing or left as a placeholder — see
# backend/app/core/config.py.

# One of: development | test | production
ENVIRONMENT=development

# SQLAlchemy connection string. Must be a real PostgreSQL URL in production
# (postgresql+psycopg://user:password@host:port/dbname).
# A local sqlite file is acceptable for development only.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/financial_contract_risk_reader

# Anthropic API key used by the Generation Service (Grounding_and_Evidence_Spec.md).
# Backend-only. Never expose to the frontend, never log this value.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed frontend origins for CORS. Set this to the
# real production frontend origin(s) before deploying — never leave it at
# the localhost development default (docs/SECURITY_AUDIT.md SS12).
CORS_ORIGINS=http://localhost:3000

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Upload / parsing limits (Phase 2) --- Safe defaults; see app/core/config.py.
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_PDF_PAGES=200
MAX_DOCX_PARAGRAPHS=5000
MIN_TEXT_CHARS=200
MIN_AVG_CHARS_PER_PAGE=20.0

# Local-filesystem MVP storage root for uploaded document originals — never
# served directly or exposed via any API response. Gitignored (see
# ../.gitignore's uploads/ entry). Must be writable by the backend process.
# See docs/BACKUP_AND_RESTORE.md for how this is backed up.
UPLOAD_DIR=./data/uploads

# --- Clause Understanding / Retrieval (Phase 4) ---
# sentence-transformers model — runs locally, no external API call.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY_FLOOR=0.3
RETRIEVAL_MIN_LEXICAL_FLOOR=0.1
# The taxonomy/corpus version this running system expects to score against.
TAXONOMY_VERSION=taxonomy_v1
CORPUS_VERSION=corpus_v1
# Local persistence directory for the Chroma vector store (permanent corpus
# embeddings only — never per-user document data). See docs/BACKUP_AND_RESTORE.md.
CHROMA_PERSIST_DIR=./data/chroma

# --- Generation Service / Grounding Guard (Phase 7) ---
GENERATION_MAX_RETRIES=1
GENERATION_MAX_CALLS_PER_DOCUMENT=60
GENERATION_TIMEOUT_SECONDS=30.0
GENERATION_MAX_OUTPUT_TOKENS=1024

# --- Upload rate limiting (Phase 10) --- In-process, per-IP, fixed-window.
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60.0

# --- Trusted-proxy IP resolution (Phase 11) ---
# Only set to true if this deployment genuinely sits directly behind
# exactly one trusted reverse proxy that sets X-Forwarded-For itself (e.g.
# the platform's own routing layer). X-Forwarded-For is attacker-controlled
# input and is never honored otherwise — see docs/PROVISIONAL_DECISIONS.md
# P11.5 and docs/SECURITY_AUDIT.md SS5. Leave false for direct-connection
# deployments or when unsure.
TRUST_PROXY_HEADERS=false

# --- Automatic retention (Phase 11) ---
# Documents and all derived data older than this are deleted by
# scripts/run_retention_cleanup.py, which must be scheduled externally
# (cron / a platform's scheduled-task feature) — see
# docs/DEPLOYMENT_CHECKLIST.md. This app does not run its own scheduler.
DOCUMENT_RETENTION_DAYS=90

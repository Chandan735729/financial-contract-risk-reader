# ==================================================
# Secrets & environment
# ==================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*secret*
!**/tests/**secret*

# ==================================================
# Python / backend
# ==================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg
# PHASE_6.5: `corpus/build/` is a tracked source package (corpus seed-build
# pipeline), not a Python packaging build artifact — re-include it despite
# the generic `build/` ignore above. __pycache__/ inside it is still
# ignored via the rule above.
!corpus/build/
!corpus/build/*.py

# ==================================================
# Node / frontend
# ==================================================
node_modules/
.next/
out/
frontend/dist/
frontend/build/
coverage/
.turbo/
next-env.d.ts
*.tsbuildinfo
.eslintcache

# ==================================================
# Databases / local persistence
# ==================================================
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
/backend/*.db
/backend/dev.db
/backend/test.db

# Chroma / local vector store persistence
chroma/
*.chroma/
chroma_data/
vector_store/

# ==================================================
# Uploaded / generated documents (never committed — user financial data)
# ==================================================
uploads/
tmp_uploads/
generated_reports/
*.uploaded
media/

# ==================================================
# Evaluation run outputs (Phase 6) — timestamped, regenerable, never a
# source-of-truth artifact; keep the repo from accumulating one file per run.
# ==================================================
/corpus/eval/results/*.json
!/corpus/eval/results/.gitkeep

# ==================================================
# OS / editor artifacts
# ==================================================
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ==================================================
# Logs (defense in depth — structured logs must never contain
# sensitive content by design, but raw log files are never committed)
# ==================================================
*.log
logs/
